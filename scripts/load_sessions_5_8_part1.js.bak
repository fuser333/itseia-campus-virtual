\`\`\`

### Paso 3: Mostrar reporte
\`\`\`python
def mostrar_reporte(estudiantes):
    print("\\n=== REPORTE DE NOTAS ===")
    for i, (nombre, nota) in enumerate(estudiantes, 1):
        estado = "APROBADO" if nota >= 70 else "REPROBADO"
